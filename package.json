{
  "name": "deepseek-balance-monitor",
  "displayName": "AI Usage Monitor",
  "description": "Monitor DeepSeek API balance and Claude Code token usage",
  "version": "0.2.0",
  "publisher": "your-publisher-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/huihuihenqiang/deepseek-balance-monitor"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "AI Usage Monitor",
      "properties": {
        "deepseek-balance.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your DeepSeek API key"
        },
        "deepseek-balance.refreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 120,
          "description": "Auto-refresh interval in minutes (for both balance and usage)"
        },
        "deepseek-balance.currency": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "CNY",
            "USD"
          ],
          "enumDescriptions": [
            "Show the currency returned by the API",
            "Always show CNY",
            "Always show USD"
          ],
          "description": "Preferred currency to display"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseek-balance-sidebar",
          "title": "AI Usage",
          "icon": "$(graph-line)"
        }
      ]
    },
    "views": {
      "deepseek-balance-sidebar": [
        {
          "type": "webview",
          "id": "deepseek-balance.panel",
          "name": "Usage Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "deepseek-balance.refresh",
        "title": "Refresh All"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
