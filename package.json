{
  "name": "deepseek-balance-monitor",
  "displayName": "DeepSeek Balance Monitor",
  "description": "Monitor your DeepSeek API balance in real-time",
  "version": "0.1.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "DeepSeek Balance Monitor",
      "properties": {
        "deepseek-balance.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your DeepSeek API key"
        },
        "deepseek-balance.refreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 120,
          "description": "Auto-refresh interval in minutes"
        },
        "deepseek-balance.currency": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "CNY",
            "USD"
          ],
          "enumDescriptions": [
            "Show the currency returned by the API",
            "Always show CNY",
            "Always show USD"
          ],
          "description": "Preferred currency to display"
        },
        "deepseek-balance.modelPricing": {
          "type": "object",
          "default": {
            "deepseek-v4-pro": {
              "inputPerMTok": 3.0,
              "cacheHitPerMTok": 0.025,
              "outputPerMTok": 6.0
            },
            "deepseek-v4-flash": {
              "inputPerMTok": 1.0,
              "cacheHitPerMTok": 0.02,
              "outputPerMTok": 2.0
            }
          },
          "description": "Per-model pricing for cost calculation (CNY per million tokens)"
        },
        "deepseek-balance.claudeScanInterval": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 120,
          "description": "Claude Code local JSONL scan interval in minutes"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseek-balance-sidebar",
          "title": "DeepSeek Balance",
          "icon": "$(graph-line)"
        }
      ]
    },
    "views": {
      "deepseek-balance-sidebar": [
        {
          "type": "webview",
          "id": "deepseek-balance.panel",
          "name": "Balance Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "deepseek-balance.refresh",
        "title": "Refresh Balance"
      },
      {
        "command": "deepseek-balance.claudeRefresh",
        "title": "Refresh Claude Code Usage"
      },
      {
        "command": "deepseek-balance.exportCSV",
        "title": "Export Usage CSV"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
